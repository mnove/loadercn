{
  "name": "loadercn",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm registry:build && next dev",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "registry:build": "shadcn build && node scripts/registry-catalog.mjs",
    "registry:validate": "shadcn registry validate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "color": "^5.0.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sugar-high": "^2.4.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/color": "^4.2.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
